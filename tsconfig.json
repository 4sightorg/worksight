{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    // "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@worksight/common/*": ["packages/common/src/*"],
      "@worksight/common": ["packages/common/src"],
      "@worksight/assets/*": ["packages/assets/*"],
      "@worksight/api/*": ["apps/api/src/*"],
      "@worksight/docs/*": ["apps/docs/src/*"],
      "@worksight/web/*": ["apps/web/src/*"]
    }
  },
  "plugins": [{ "name": "next" }],
  "include": ["apps", "packages"]
  // "references": [{ "path": "packages/common" }, { "path": "apps/api" }, { "path": "apps/docs" }, { "path": "apps/web" }]
}
