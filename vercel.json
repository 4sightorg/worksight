{
  "version": 2,
  "framework": "nextjs",
  "engines": {
    "node": "20.x",
    "pnpm": "9.x"
  },
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter web run build",
  "outputDirectory": "apps/web/.next",
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}
