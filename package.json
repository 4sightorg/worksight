{
  "name": "worksight",
  "private": false,
  "version": "1.0.0",
  "description": "Check your tasks, manage your well-being",
  "workspaces": [
    "apps/api",
    "apps/docs",
    "apps/web",
    "packages/assets",
    "packages/common"
  ],
  "scripts": {
    "build": "turbo build",
    "build:web": "turbo build --filter=@worksight/web",
    "build:docs": "turbo build --filter=@worksight/docs",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@worksight/web",
    "dev:docs": "turbo dev --filter=@worksight/docs",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "quality": "turbo quality",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "release": "run-s build changeset:publish",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "version-packages": "changeset version",
    "test": "turbo test",
    "test:ci": "turbo test:ci"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "run-s": "^0.0.0",
    "ts-jest": "^29.4.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  },
  "dependencies": {
    "@worksight/common": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
