{
  "name": "worksight",
  "private": false,
  "version": "1.0.0",
  "description": "Check your tasks, manage your well-being",
  "scripts": {
    "build": "turbo build",
    "build:web": "turbo build --filter=@worksight/web",
    "build:docs": "turbo build --filter=@worksight/docs",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@worksight/web",
    "dev:docs": "turbo dev --filter=@worksight/docs",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "quality": "turbo quality",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "release": "run-s build changeset:publish",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "version-packages": "changeset version",
    "test": "turbo test",
    "test:ci": "turbo test:ci"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "csstype": "^3.1.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "undici-types": "^7.16.0",
    "zod": "^4.1.11"
  },
  "dependencies": {
    "@worksight/common": "workspace:*"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
