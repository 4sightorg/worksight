{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "@worksight/common/*": ["packages/common/src/*"],
      "@worksight/assets/*": ["packages/assets/*"],
      "@worksight/api/*": ["apps/api/src/*"],
      "@worksight/docs/*": ["apps/docs/src/*"],
      "@worksight/web/*": ["apps/web/src/*"]
    }
  },
  "include": [],
  "references": [{ "path": "packages/common" }, { "path": "apps/api" }, { "path": "apps/docs" }, { "path": "apps/web" }]
}
