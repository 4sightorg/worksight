{
  "name": "@worksight/assets",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },

  "files": [
    "dist",
    "logos",
    "screenshots"
  ],
  "scripts": {
    "build": "tsc && cp -r src/logos dist/ && cp -r src/screenshots dist/",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
