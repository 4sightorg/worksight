{
  "name": "@worksight/common",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./data": {
      "types": "./dist/esm/data/index.d.ts",
      "import": "./dist/esm/data/index.js",
      "require": "./dist/cjs/data/index.js"
    },
    "./types": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.js"
    },
    "./utils": {
      "types": "./dist/esm/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json --resolve-full-paths",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json --resolve-full-paths && node ./scripts/write-cjs-package.mjs",
    "dev": "tsc -w -p tsconfig.esm.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:strict": "eslint --max-warnings 30 \"src/**/*.ts\"",
    "prettier": "prettier --write \"**/*.{js,ts,md}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,md}\"",
    "format": "run-s prettier lint:fix",
    "format:check": "run-s prettier:check lint:strict",
    "type-check": "tsc --noEmit -p tsconfig.esm.json",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo tsconfig.esm.tsbuildinfo tsconfig.cjs.tsbuildinfo"
  },
  "peerDependencies": {
    "zod": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "csstype": "^3.1.3",
    "npm-run-all": "^4.1.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "undici-types": "^7.16.0"
  }
}
