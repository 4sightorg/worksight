{
  "name": "@worksight/common",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -w",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:strict": "eslint --max-warnings 30 \"src/**/*.ts\"",
    "prettier": "prettier --write \"**/*.{js,ts,md}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,md}\"",
    "format": "run-s prettier lint:fix",
    "format:check": "run-s prettier:check lint:strict",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next dist .turbo tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "zod": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "csstype": "^3.1.3",
    "npm-run-all": "^4.1.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "undici-types": "^7.16.0"
  }
}
